@startuml

!include <C4/C4_Component>

title Component Diagram - File Upload API

LAYOUT_TOP_DOWN()

Person(user, "API User", "Uses file operations allowed by the assigned role.")

Container_Boundary(fileUploadApi, "File Upload API") {

    Component(authController, "Authentication API", "AuthController", "Accepts login requests and returns JWT access tokens.")
    Component(fileController, "File API", "FileController", "Exposes upload batch upload list and download endpoints.")
    Component(security, "Security Component", "Spring Security / JWT", "Authenticates users and validates JWT tokens. Enforces role-based access.",$link="04-code-security.puml")
    Component(fileStorageService, "File Storage Service", "FileStorageService", "Validates files and coordinates storage metadata persistence and transactions.")
    Component(activityLogService, "Activity Log Service", "ActivityLogService", "Records successful and failed security and file operations.")
    Component(repositories, "Repository Layer", "Spring Data JPA", "Provides access to users roles file metadata and activity logs.")
    Component(exceptionHandler, "Global Exception Handler", "Spring REST Advice", "Converts application exceptions into structured HTTP error responses.")
    Component(apiDocumentation, "API Documentation", "Springdoc OpenAPI", "Publishes Swagger and OpenAPI documentation for REST endpoints.")
}

ContainerDb(fileStorage, "File Storage", "Local file system", "Stores uploaded file contents in the uploads directory.")
ContainerDb(database, "Application Database", "MySQL", "Stores users roles file metadata and activity logs.")

Rel(user, authController, "Sends login credentials", "POST /api/auth/login")
Rel(authController, security, "Authenticates credentials and creates a JWT")
Rel(user, security, "Sends protected requests with a bearer token", "HTTP/REST")
Rel(security, fileController, "Allows authorized file requests")
Rel(security, repositories, "Loads users and roles")
Rel(security, activityLogService, "Records security failures")
Rel(fileController, fileStorageService, "Delegates file operations")
Rel(fileController, exceptionHandler, "Routes application errors to")
Rel(fileStorageService, fileStorage, "Reads and writes file contents", "Java NIO")
Rel(fileStorageService, repositories, "Reads and writes file metadata")
Rel(fileStorageService, activityLogService, "Records file operations")
Rel(activityLogService, repositories, "Stores activity logs")
Rel(repositories, database, "Reads and writes application data", "JPA / JDBC")
Rel(apiDocumentation, authController, "Documents")
Rel(apiDocumentation, fileController, "Documents")


SHOW_LEGEND()

@enduml